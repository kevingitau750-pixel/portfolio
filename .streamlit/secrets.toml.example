# Copy this file to `secrets.toml` (same folder) and set your own password.
# `secrets.toml` is git-ignored, so it never leaves your machine.
#
# On Streamlit Community Cloud, do NOT commit the file — paste the same line
# into App settings -> Secrets instead.
#
# Use a long random passphrase. The literal value below is rejected by the app.

admin_password = "CHANGE-ME"
